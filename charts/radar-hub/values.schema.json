{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "radar-hub values",
  "type": "object",
  "required": [
    "image",
    "license",
    "postgres",
    "hub",
    "auth",
    "service"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's reserved umbrella-chart namespace. Left open on purpose: a parent chart writes arbitrary keys here and this chart does not own the shape.",
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "hub": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "agentSandbox": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "license": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "database": {
                  "type": "string",
                  "minLength": 1
                },
                "username": {
                  "type": "string",
                  "minLength": 1
                },
                "password": {
                  "type": "string"
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "cnpgCluster": {
              "type": "string"
            }
          }
        }
      }
    },
    "hub": {
      "type": "object",
      "required": [
        "publicURL"
      ],
      "properties": {
        "publicURL": {
          "type": "string",
          "minLength": 1
        },
        "cookiePassword": {
          "type": "string"
        },
        "cookiePasswordExistingSecret": {
          "type": "string"
        },
        "orgName": {
          "type": "string"
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "installPodLabels": {
          "$ref": "#/definitions/labels"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "agent": {
          "type": "object",
          "required": [
            "enabled",
            "provider"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "enum": [
                "anthropic",
                "bedrock",
                "vertex"
              ]
            },
            "engineLabel": {
              "type": "string"
            },
            "alertAnalysis": {
              "type": "boolean"
            },
            "credentials": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "apiKey": {
                  "type": "string"
                },
                "serviceAccountJSON": {
                  "type": "string"
                },
                "podDSN": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "anthropic": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "bedrock": {
              "type": "object",
              "properties": {
                "region": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "vertex": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "sandbox": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "maxLength": 63
                },
                "create": {
                  "type": "boolean"
                },
                "networkPolicy": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "postgresPort": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "extraEgress": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "airGapped": {
          "type": "boolean",
          "description": "Make no outbound connections at all: no Radar version check, no license renewal. For deployments audited on having no egress."
        },
        "licenseServer": {
          "type": "string",
          "description": "Where the hub asks for a renewed license. Empty means the Skyhook default. Ignored when airGapped is true."
        },
        "cloudAppURL": {
          "type": "string",
          "pattern": "^$|^https?://([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*|\\[[0-9A-Fa-f:.]+\\])(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?/?$",
          "description": "Origin of the Radar Cloud web app this hub's license belongs to, used only for links into Cloud. Bare http(s) origin, no path. Empty means https://app.radarhq.io."
        },
        "latestRadarVersion": {
          "type": "string",
          "description": "Pin the Radar version the UI reports as latest. Empty means ask GitHub hourly; required for an air-gapped install to show a version at all."
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "selfSigned": {
              "type": "boolean"
            },
            "certificate": {
              "type": "string",
              "description": "PEM certificate the web pod serves on its https port. Set with privateKey. existingSecret takes precedence."
            },
            "privateKey": {
              "type": "string",
              "description": "PEM private key for certificate. Set with certificate."
            },
            "existingSecret": {
              "type": "string",
              "description": "Secret of type kubernetes.io/tls in the release namespace that the web pod serves on its https port. Empty means the chart renders a self-signed one for the host in hub.publicURL."
            },
            "inCluster": {
              "type": "boolean",
              "description": "Keep the self-signed https listener on the web Service for Radar agents in this cluster, also when public traffic goes through an Ingress or Gateway."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "localCluster": {
      "type": "object",
      "description": "The cluster the hub runs in, registered by the hub as \"local\". Set id with either token or existingSecret.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_-]{11}$",
          "description": "Cluster id, 11 characters of A-Z, a-z, 0-9, - and _. The Radar agent in this cluster uses it as clusterName."
        },
        "token": {
          "type": "string",
          "description": "Agent token for the local cluster, written to the chart's Secret. \"rhc_\" followed by 43 characters of A-Z, a-z, 0-9, - and _, the form the hub mints.",
          "pattern": "^$|^rhc_[A-Za-z0-9_-]{43}$"
        },
        "existingSecret": {
          "type": "string",
          "description": "Secret in the release namespace holding the agent token."
        },
        "existingSecretKey": {
          "type": "string",
          "description": "Key inside existingSecret. Empty means token."
        }
      },
      "additionalProperties": false
    },
    "enrollment": {
      "type": "object",
      "description": "Install key that lets Radar agents join this hub. Set key or existingSecret.",
      "properties": {
        "key": {
          "type": "string",
          "description": "Install key, written to the chart's Secret. \"rhe_\" followed by 43 characters of A-Z, a-z, 0-9, - and _."
        },
        "existingSecret": {
          "type": "string",
          "description": "Secret in the release namespace holding the install key."
        },
        "existingSecretKey": {
          "type": "string",
          "description": "Key inside existingSecret. Empty means key."
        },
        "trustByDefault": {
          "type": "boolean",
          "description": "Whether clusters that join with this install key start out trusted."
        },
        "approval": {
          "type": "string",
          "enum": ["auto", "manual"],
          "description": "auto: clusters join right away. manual: an owner approves each new cluster on the Clusters page."
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "breakGlass": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "passwordHash": {
              "type": "string"
            },
            "passwordHashExistingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "clientSecretExistingSecret": {
              "type": "string"
            },
            "callbackURL": {
              "type": "string"
            },
            "defaultRole": {
              "type": "string",
              "enum": [
                "owner",
                "member",
                "viewer"
              ]
            },
            "groupsClaim": {
              "type": "string"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "useRefreshToken": {
              "type": "boolean"
            },
            "clusterAccess": {
              "type": "string",
              "enum": [
                "",
                "roles",
                "idp",
                "token"
              ]
            },
            "k8sUsernamePrefix": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[!-+\\--~]*$",
              "not": { "pattern": "^(-$|radar:|cloud:|system:)" }
            },
            "k8sGroupsPrefix": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[!-+\\--~]*$",
              "not": { "pattern": "^(-$|radar:|cloud:|system:)" }
            },
            "clusterToken": {
              "type": "string",
              "enum": [
                "id_token",
                "access_token"
              ]
            },
            "clusterTokenAudience": {
              "type": "string"
            },
            "emailClaim": {
              "type": "string"
            },
            "mcpOAuth": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "audience": { "type": "string" },
                "requiredScope": { "type": "string" },
                "tokenExchange": {
                  "type": "object",
                  "properties": {
                    "strategy": { "type": "string", "enum": ["", "rfc8693", "entra-obo"] },
                    "audience": { "type": "string" },
                    "scopes": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {
            "maxLifetime": {
              "type": "string",
              "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            },
            "maxInactive": {
              "type": "string",
              "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string"
        },
        "docsURL": {
          "type": "string"
        },
        "supportEmail": {
          "type": "string"
        },
        "feedbackEmail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secretName"
            ],
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "defaultTimeout": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            },
            "tlsPort": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "hub": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podLabels": {
      "$ref": "#/definitions/labels"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "labels": {
      "description": "Kubernetes labels: keys are an optional DNS-subdomain prefix (at most 253 characters) and a name of at most 63 characters; values are strings of at most 63 letters, digits, '-', '_' or '.', starting and ending with a letter or digit.",
      "type": "object",
      "propertyNames": {
        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
        "not": {
          "pattern": "^[^/]{254,}/"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]{0,61})?[A-Za-z0-9])?$"
      }
    }
  }
}
