{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "radar-hub values",
  "type": "object",
  "required": [
    "image",
    "license",
    "postgres",
    "hub",
    "auth",
    "service"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's reserved umbrella-chart namespace. Left open on purpose: a parent chart writes arbitrary keys here and this chart does not own the shape.",
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "hub": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "license": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "database": {
                  "type": "string",
                  "minLength": 1
                },
                "username": {
                  "type": "string",
                  "minLength": 1
                },
                "password": {
                  "type": "string"
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "cnpgCluster": {
              "type": "string"
            }
          }
        }
      }
    },
    "hub": {
      "type": "object",
      "required": [
        "publicURL"
      ],
      "properties": {
        "publicURL": {
          "type": "string",
          "minLength": 1
        },
        "cookiePassword": {
          "type": "string"
        },
        "cookiePasswordExistingSecret": {
          "type": "string"
        },
        "orgName": {
          "type": "string"
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "airGapped": {
          "type": "boolean",
          "description": "Make no outbound connections at all: no Radar version check, no license renewal. For deployments audited on having no egress."
        },
        "latestRadarVersion": {
          "type": "string",
          "description": "Pin the Radar version the UI reports as latest. Empty means ask GitHub hourly; required for an air-gapped install to show a version at all."
        },
        "licenseServer": {
          "type": "string",
          "description": "Where the hub asks for a renewed license. Empty means the Skyhook default. Ignored when airGapped is true."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "selfSigned": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "breakGlass": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "passwordHash": {
              "type": "string"
            },
            "passwordHashExistingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientID": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "clientSecretExistingSecret": {
              "type": "string"
            },
            "callbackURL": {
              "type": "string"
            },
            "defaultRole": {
              "type": "string",
              "enum": [
                "owner",
                "member",
                "viewer"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string"
        },
        "docsURL": {
          "type": "string"
        },
        "supportEmail": {
          "type": "string"
        },
        "feedbackEmail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secretName"
            ],
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "defaultTimeout": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            },
            "tlsPort": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "hub": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
